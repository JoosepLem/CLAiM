```mermaid
flowchart TB
    employee("Medical Centre Employee\n[Person]\nUploads invoices and reviews reconciliation results.")

    subgraph spring_boot["Web Application"]
        auth["Auth Controller\n[Component: Spring Security + JWT]\nUsername-based login. Validates user against public.users, issues tenant-scoped JWT in secure HttpOnly cookie."]
        tenant_int["Tenant Interceptor\n[Component: HandlerInterceptor]\nExtracts tenant ID from JWT claim on every request, sets TenantContext for schema-scoped queries."]
        ui["Invoice UI Controller\n[Component: Thymeleaf + Spring MVC]\nRenders invoice upload forms, validation feedback, and reconciliation result tables with status badges."]
        invoice_svc["Invoice Service\n[Component: Kotlin service]\nOrchestrates upload pipeline: validates PDF, selects parser by partner, encrypts isikukood, persists invoice lines."]
        parser_registry["Parser Registry\n[Component: Map.&lt;String, InvoiceParser&gt;]\nStrategy pattern. Holds one InvoiceParser implementation per partner ID. Auto-wired by Spring."]
        encryption_svc["Encryption Service\n[Component: Kotlin service, Caffeine cache]\nEnvelope encryption of isikukood. AES-256-GCM encryption and HMAC-SHA256 hashing per tenant DEK. Caffeine cache with 30-min TTL."]
        recon_engine["Reconciliation Engine\n[Component: Kotlin service]\nMatches partner invoice lines to treatment lines by HMAC hash + procedure code. Compares amounts, classifies as matched, amount mismatch, or unmatched."]
        audit_svc["Audit Service\n[Component: Kotlin service]\nWrites append-only audit events via SECURITY DEFINER PostgreSQL function. Captures user, action, endpoint, record type, fields accessed, and purpose."]
    end

    postgres[("Database\n[Container: PostgreSQL on AWS RDS]\nPer-tenant schemas for invoice data and tenant_keys. Cross-tenant audit_log schema with hash chain integrity.")]

    employee -->|"Uploads invoices, views results\nHTTPS"| ui
    ui -->|"Delegates authentication"| auth
    ui -->|"Creates invoices on upload"| invoice_svc
    ui -->|"Triggers reconciliation"| recon_engine
    auth -->|"Stores tenant in security context"| tenant_int
    tenant_int -->|"Provides tenant-scoped context"| ui

    invoice_svc -->|"Selects parser by partner ID"| parser_registry
    invoice_svc -->|"Encrypts isikukood, computes HMAC hash"| encryption_svc
    invoice_svc -->|"Logs CREATE events"| audit_svc
    invoice_svc -->|"Persists encrypted invoice lines\nSQL/TCP (SSL)"| postgres

    recon_engine -->|"Looks up by HMAC hash"| encryption_svc
    recon_engine -->|"Logs READ events"| audit_svc
    recon_engine -->|"Queries and matches invoice lines\nSQL/TCP (SSL)"| postgres

    encryption_svc -->|"Reads and writes encrypted DEKs\nSQL/TCP (SSL)"| postgres
    audit_svc -->|"Calls log_audit_event() function\nSQL/TCP (SSL)"| postgres

