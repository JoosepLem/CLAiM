```mermaid
flowchart TB
    spring_boot["Web Application\n[Container: Spring Boot + Kotlin]\nConnects as single app_user over SSL."]

    subgraph postgres["Database"]
        subgraph public_schema["public schema"]
            users_table["users\n[Table]\nMaps username to tenant_id (schema name). Read-only for app_user. Used during login to resolve tenant."]
        end

        subgraph tenant_schema["tenant schema (one per clinic)"]
            treatment_table["treatment_invoices\n[Table]\nEncrypted isikukood (BYTEA, AES-256-GCM), isikukood_hash (BYTEA, HMAC-SHA256), procedure_code, amount, treatment_date, key_version."]
            partner_table["partner_invoices\n[Table]\nEncrypted isikukood, isikukood_hash, procedure_code, amount, service_date, provider_name, key_version."]
            keys_table["tenant_keys\n[Table]\nHolds per-tenant DEKs: tenant_id, key_version, encrypted_dek (BYTEA, wrapped via KMS), created_at."]
        end

        subgraph audit_schema["audit_log schema"]
            audit_table["audit_events\n[Table]\nAppend-only. id, event_time, username, action, endpoint, record_type, record_id, fields_accessed, purpose, ip_address, user_agent, success, details (JSONB), chain_hash (BYTEA)."]
            audit_fn["log_audit_event()\n[SECURITY DEFINER function]\nComputes SHA-256 hash chain over previous entry and current data. Owned by app_migrator. App user has only EXECUTE permission."]
        end
    end

    spring_boot -->|"SELECT username → tenant_id\nSQL/TCP (SSL)"| users_table
    spring_boot -->|"INSERT, SELECT by isikukood_hash\nSQL/TCP (SSL)"| treatment_table
    spring_boot -->|"INSERT, SELECT by isikukood_hash\nSQL/TCP (SSL)"| partner_table
    spring_boot -->|"SELECT encrypted DEK\nSQL/TCP (SSL)"| keys_table
    spring_boot -->|"EXECUTE to log events\nSQL/TCP (SSL)"| audit_fn
    audit_fn -->|"INSERT event with chain hash"| audit_table
    treatment_table -->|"key_version references"| keys_table
    partner_table -->|"key_version references"| keys_table

